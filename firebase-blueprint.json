{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgriIaSchema",
  "description": "Firestore schema for AGRI-IA application",
  "entities": {
    "UserProfile": {
      "collection": "users",
      "documentId": "{userId}",
      "fields": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "preferredLanguage": { "type": "string" },
        "experienceLevel": { "type": "string" },
        "region": { "type": "string" },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["userId", "name", "preferredLanguage"]
    },
    "Farm": {
      "collection": "users/{userId}/farms",
      "documentId": "{farmId}",
      "fields": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "region": { "type": "string" },
        "commune": { "type": "string" },
        "areaHectares": { "type": "number" },
        "soilType": { "type": "string" },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["userId", "name"]
    },
    "Plot": {
      "collection": "users/{userId}/plots",
      "documentId": "{plotId}",
      "fields": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "farmId": { "type": "string" },
        "name": { "type": "string" },
        "areaHectares": { "type": "number" },
        "cropName": { "type": "string" },
        "soilType": { "type": "string" },
        "plantingDate": { "type": "string" },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["userId", "name", "cropName"]
    },
    "Intervention": {
      "collection": "users/{userId}/interventions",
      "documentId": "{interventionId}",
      "fields": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "plotId": { "type": "string" },
        "type": { "type": "string" },
        "date": { "type": "string" },
        "quantity": { "type": "string" },
        "costCfa": { "type": "number" },
        "notes": { "type": "string" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["userId", "type", "date"]
    },
    "Livestock": {
      "collection": "users/{userId}/livestock",
      "documentId": "{livestockId}",
      "fields": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "species": { "type": "string" },
        "breed": { "type": "string" },
        "count": { "type": "number" },
        "notes": { "type": "string" },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["userId", "species", "count"]
    },
    "Diagnosis": {
      "collection": "users/{userId}/diagnoses",
      "documentId": "{diagId}",
      "fields": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "cropName": { "type": "string" },
        "partAffected": { "type": "string" },
        "symptoms": { "type": "string" },
        "diagnosisResult": { "type": "string" },
        "confidence": { "type": "number" },
        "recommendations": { "type": "string" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["userId", "cropName", "diagnosisResult"]
    },
    "Chat": {
      "collection": "users/{userId}/chats",
      "documentId": "{chatId}",
      "fields": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "lastMessage": { "type": "string" },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["userId", "title"]
    },
    "ChatMessage": {
      "collection": "users/{userId}/chats/{chatId}/messages",
      "documentId": "{messageId}",
      "fields": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "chatId": { "type": "string" },
        "role": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "timestamp" }
      },
      "required": ["userId", "chatId", "role", "content"]
    }
  }
}
